{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Library window with a native folder picker and file drop events.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
