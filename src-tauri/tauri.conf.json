{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Library",
  "version": "0.1.2",
  "identifier": "app.skilllibrary.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Library",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "width": 1280,
        "height": 820,
        "minWidth": 670,
        "minHeight": 480,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:1420 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNTdDNEU3QzNFNzNEMEQKUldRTlBlZkQ1OFJYQ3BLdGRibnZZNkxxQ1NGKzVUaXFLNzNSWFQ0WGxsZ3R3MjVQOXVkZFFvWm0K",
      "endpoints": [
        "https://github.com/sunyifeng11111/skill-library/releases/latest/download/latest.json"
      ]
    }
  }
}
